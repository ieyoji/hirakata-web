  "version": "1.0.0",
  "babs": [
    {
      "id": "bab1_hiragana",
      "script": "hiragana",
      "title": {
        "id": "Hiragana",
        "en": "Hiragana"
      },
      "lessons": [
        {
          "id": "intro",
          "type": "introduction",
          "title": {
            "id": "Pendahuluan",
            "en": "Introduction"
          },
          "subtitle": {
            "id": "Hiragana dan Katakana",
            "en": "Hiragana and Katakana"
          },
          "cards": [
            {
              "title": {
                "id": "Dua Sistem Huruf Kana",
                "en": "Two Kana Writing Systems"
              },
              "body": {
                "id": "Bahasa Jepang memakai dua sistem huruf bunyi: Hiragana dan Katakana. Setiap huruf kana mewakili satu bunyi suku kata, misalnya か selalu dibaca 'ka'. Jika kamu menguasai kana, kamu bisa membaca bunyi kata Jepang apa pun.",
                "en": "Japanese uses two syllabic writing systems: Hiragana and Katakana. Each kana character stands for one syllable sound, for example か is always read 'ka'. Once you know kana, you can sound out any Japanese word."
              }
            },
            {
              "title": {
                "id": "Hiragana untuk Kata Asli Jepang",
                "en": "Hiragana for Native Japanese Words"
              },
              "body": {
                "id": "Hiragana dipakai untuk kata asli Jepang, partikel, dan akhiran kata kerja, misalnya たべもの (makanan) dan partikel は. Bentuk hurufnya halus dan membulat. Hiragana adalah sistem pertama yang dipelajari di jalur ini.",
                "en": "Hiragana is used for native Japanese words, particles, and verb endings, such as たべもの (food) and the particle は. Its letterforms are soft and rounded. Hiragana is the first system you will learn on this path."
              }
            },
            {
              "title": {
                "id": "Katakana untuk Kata Serapan",
                "en": "Katakana for Borrowed Words"
              },
              "body": {
                "id": "Katakana dipakai untuk kata serapan dari bahasa asing, nama asing, dan penekanan, misalnya コーヒー (kopi). Bunyi setiap hurufnya sama dengan padanan Hiragananya, tetapi bentuknya lebih lurus dan bersudut.",
                "en": "Katakana is used for words borrowed from other languages, foreign names, and emphasis, such as コーヒー (coffee). Each character sounds exactly like its Hiragana counterpart, but the shapes are straighter and more angular."
              }
            },
            {
              "title": {
                "id": "Urutan Coretan Itu Penting",
                "en": "Stroke Order Matters"
              },
              "body": {
                "id": "Setiap kana ditulis dengan urutan dan arah coretan yang tetap. Menulis dengan urutan yang benar membuat hurufmu mudah dibaca dan terasa alami. Di setiap pelajaran, kartu perkenalan menampilkan animasi urutan coretan sebelum kamu berlatih menulis.",
                "en": "Every kana is written with a fixed stroke order and direction. Writing in the correct order keeps your characters readable and natural. In each lesson, the introduction card shows the animated stroke order before you practise writing."
              }
            },
            {
              "title": {
                "id": "Tanda Bunyi Tambahan",
                "en": "Extra Sound Marks"
              },
              "body": {
                "id": "Dua tanda kecil mengubah bunyi huruf dasar: dakuten (゛) mengubah か menjadi が, dan handakuten (゜) mengubah は menjadi ぱ. Huruf っ kecil menggandakan konsonan berikutnya, dan vokal panjang memanjangkan bunyi vokal. Semuanya akan dipelajari di Bab 3 dan Bab 4.",
                "en": "Two small marks change the sound of a base character: dakuten (゛) turns か into が, and handakuten (゜) turns は into ぱ. A small っ doubles the following consonant, and long vowels stretch a vowel sound. You will learn all of these in Bab 3 and Bab 4."
              }
            },
            {
              "title": {
                "id": "Cara Kerja Jalur Pelajaran Ini",
                "en": "How This Lesson Path Works"
              },
              "body": {
                "id": "Pelajaran terbuka satu per satu secara berurutan. Selesaikan satu ronde dengan nilai sempurna 100% untuk membuka ronde berikutnya, dan selesaikan semua ronde dalam satu Bab untuk membuka Bab selanjutnya. Kartu pendahuluan ini tidak dinilai, jadi santai saja dan selamat belajar!",
                "en": "Lessons unlock one by one in order. Finish a round with a perfect 100% score to unlock the next round, and complete every round in a Bab to open the next Bab. These introduction cards are not scored, so relax and enjoy learning!"
              }
            }
          ]
        },
